{
  "name": "game-shop-fe",
  "version": "1.0.0",
  "description": "游戏内商品购买网站 - React 18 + TypeScript + Webpack 5",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "dev": "webpack serve --mode development --open",
    "build": "cross-env REACT_APP_ENV_STAGE=prod webpack --mode production",
    "build:test": "cross-env REACT_APP_ENV_STAGE=test webpack --mode production",
    "build:analyze": "webpack --mode production --analyze",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,less,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,less,css,json}\""
  },
  "dependencies": {
    "@airwallex/components-sdk": "^1.27.2",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.5.3",
    "amfe-flexible": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "lib-flexible": "^0.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "stripe": "^20.0.0",
    "thinkingdata-browser": "^2.2.1",
    "xxtea": "^0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^6.8.1",
    "dotenv": "^17.2.3",
    "dotenv-webpack": "^8.1.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.3",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.3",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.1.1",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
